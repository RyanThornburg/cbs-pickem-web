{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Lets imports name the .ts file. Vitest and Wrangler resolve either
    // way; kept so the Worker's imports stay explicit.
    "allowImportingTsExtensions": true
  },
  "include": ["./**/*.ts", "../worker-configuration.d.ts"]
}
