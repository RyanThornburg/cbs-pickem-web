{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cbs-pickem-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "PICKEM_KV",
      // No preview_id -- wrangler dev --remote and wrangler deploy both read
      // CBS_PICKEM_PROD now. The worker is read-only (no .put() calls
      // anywhere), so pointing local dev at prod can't write/corrupt it.
      "id": "55ae4b1a890a46d88557b9d69d9ecdd8"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
