{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cbs-pickem-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-10",
  // Served on two custom domains, morlocked.rattsnest.com and
  // morlocked.rattplex.com; one Cloudflare Access app guards /admin and
  // /api/admin/* on both (same AUD below). A workers.dev or preview URL
  // would be another hostname with no Access in front of it.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/logout"]
  },
  "kv_namespaces": [
    {
      "binding": "PICKEM_KV",
      // No preview_id -- wrangler dev --remote and wrangler deploy both read
      // CBS_PICKEM_PROD now. The worker only reads this namespace (no
      // .put() on PICKEM_KV anywhere), so pointing local dev at prod can't
      // write/corrupt it.
      "id": "55ae4b1a890a46d88557b9d69d9ecdd8"
    },
    {
      // The pipeline alert's own state (what it last emailed), kept apart so
      // PICKEM_KV stays read-only. See worker/pipelineAlert.ts.
      "binding": "ALERT_KV",
      "id": "4d37e0e725da4e9ca7c624a34a94ade3"
    }
  ],
  // Pipeline alert: every 10 minutes, email ALERT_EMAIL (a Worker secret,
  // like ADMIN_EMAIL) when the data pipeline's heartbeat stops.
  "triggers": { "crons": ["*/10 * * * *"] },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["alerts@morlocked.rattsnest.com"]
    }
  ],
  // Cloudflare Access app guarding /admin + /api/admin/*. Not secrets: the AUD
  // tag and team domain are what the Worker checks Access's JWT against (see
  // worker/access.ts). ADMIN_EMAIL -- the only login allowed through even if
  // the Access policy is ever widened -- is a Worker secret instead
  // (`wrangler secret put ADMIN_EMAIL`, `.dev.vars` locally) so the address
  // stays out of this public repo. Unset means every admin request 401s.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "rattsnest.cloudflareaccess.com",
    "ACCESS_AUD": "8908b2e7bb19ffe36d2c72106e883568c63d685a4a64f57dae05a60273c556c7"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
